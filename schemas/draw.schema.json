{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhouminghan.github.io/ssq-hub/schemas/draw.schema.json",
  "title": "SSQ draw",
  "type": "object",
  "required": ["issue", "date", "red", "blue"],
  "properties": {
    "issue": { "type": "string", "pattern": "^[0-9]{7}$" },
    "date": { "type": "string", "format": "date" },
    "red": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 33 }
    },
    "blue": { "type": "integer", "minimum": 1, "maximum": 16 }
  },
  "additionalProperties": true
}
