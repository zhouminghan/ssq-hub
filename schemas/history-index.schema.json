{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhouminghan.github.io/ssq-hub/schemas/history-index.schema.json",
  "title": "History index",
  "type": "object",
  "required": ["total", "range", "years"],
  "properties": {
    "total": { "type": "integer", "minimum": 1 },
    "range": {
      "type": "array",
      "prefixItems": [{ "type": "string", "format": "date" }, { "type": "string", "format": "date" }],
      "minItems": 2,
      "maxItems": 2
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "count", "range"],
        "properties": {
          "year": { "type": "string", "pattern": "^[0-9]{4}$" },
          "count": { "type": "integer", "minimum": 1 },
          "range": {
            "type": "array",
            "prefixItems": [{ "type": "string", "format": "date" }, { "type": "string", "format": "date" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
