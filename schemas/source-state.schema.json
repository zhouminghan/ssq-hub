{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhouminghan.github.io/ssq-hub/schemas/source-state.schema.json",
  "title": "Data source provenance state",
  "type": "object",
  "required": [
    "schema_version",
    "verified_at",
    "sources",
    "cross_checked",
    "latest_issue",
    "latest_date"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "verified_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cross_checked": { "type": "boolean" },
    "latest_issue": { "type": "string", "pattern": "^[0-9]{7}$" },
    "latest_date": { "type": "string", "format": "date" }
  }
}
